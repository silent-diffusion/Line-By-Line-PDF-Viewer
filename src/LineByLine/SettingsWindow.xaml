<Window x:Class="LineByLine.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · Line by Line" Icon="app.ico" Width="820" Height="580" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F6F6F7" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16">
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="12,0"/>
                <StackPanel>
                    <RadioButton x:Name="NavBand" Content="Focus band" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHotkeys" Content="Hotkeys" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavValueGrab" Content="Value Grab" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHighlights" Content="Highlights" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavWindow" Content="Window" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavUpdates" Content="Updates" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,26,32,24">

                <!-- Focus band -->
                <StackPanel x:Name="BandPage">
                    <TextBlock Text="Focus band" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="−" Style="{StaticResource SecondaryButton}" Width="34" Padding="0" Click="LinesMinus_Click"/>
                                <TextBlock x:Name="LinesValue" Width="36" TextAlignment="Center" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <Button Content="+" Style="{StaticResource SecondaryButton}" Width="34" Padding="0" Click="LinesPlus_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Lines in view" FontWeight="SemiBold"/>
                                <TextBlock Text="How many lines the band highlights at once." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StepMinusButton" Content="−" Style="{StaticResource SecondaryButton}" Width="34" Padding="0" Click="StepMinus_Click"/>
                                    <TextBlock x:Name="StepValue" Width="36" TextAlignment="Center" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    <Button x:Name="StepPlusButton" Content="+" Style="{StaticResource SecondaryButton}" Width="34" Padding="0" Click="StepPlus_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Step size" FontWeight="SemiBold"/>
                                    <TextBlock Text="How many lines one keypress moves the band." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="StepMatchesLines" Content="Same as lines in view" Margin="0,12,0,0"
                                      Checked="StepMatches_Changed" Unchecked="StepMatches_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="DimValue" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Dim strength" FontWeight="SemiBold"/>
                                    <TextBlock Text="How dark everything outside the band gets. Ctrl+Alt+D turns dimming on and off."
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider x:Name="DimSlider" Minimum="0" Maximum="0.85" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,12,0,0" ValueChanged="DimSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="OcrSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="OcrSwitch_Changed" Unchecked="OcrSwitch_Changed" AutomationProperties.Name="Read scanned pages with OCR"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Read scanned pages (OCR)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OcrDescription" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="2,4,0,0"
                               Text="The band snaps to the text lines in digital PDFs exactly. Scans and images are read with OCR, so check numbers against the page."/>
                </StackPanel>

                <!-- Hotkeys -->
                <StackPanel x:Name="HotkeysPage" Visibility="Collapsed">
                    <TextBlock Text="Hotkeys" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"
                               Text="These work everywhere, even while Excel has focus. Click a shortcut, then press the new key combination. Use Ctrl or Alt with a key; Esc cancels."/>
                    <Border Style="{StaticResource Card}" Padding="18,6">
                        <StackPanel x:Name="HotkeyRows"/>
                    </Border>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource SecondaryButton}" Click="ResetHotkeys_Click"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="2,0,16,0"
                                   Text="Some Intel graphics drivers use Ctrl+Alt+arrows to rotate the screen. If the band doesn't move, turn those off in the Intel control panel or pick different keys here."/>
                    </DockPanel>
                </StackPanel>

                <!-- Value Grab -->
                <StackPanel x:Name="ValueGrabPage" Visibility="Collapsed">
                    <TextBlock Text="Value Grab" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"
                               Text="Shows each highlighted line's dollar amount beside the band, so you can copy it into Excel with one keypress instead of retyping it. Still check it against the page."/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ValueGrabSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="ValueGrabSwitch_Changed" Unchecked="ValueGrabSwitch_Changed" AutomationProperties.Name="Value Grab"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Value Grab" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ValueGrabHint" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="What to copy" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <RadioButton x:Name="ModeAmount" GroupName="Mode" Margin="0,0,0,6" Checked="Mode_Checked"
                                         Content="The line's value only, as a plain number, e.g. 1825.59"/>
                            <StackPanel x:Name="PickPanel" Margin="24,2,0,8">
                                <RadioButton x:Name="PickRightmost" GroupName="Pick" Margin="0,0,0,4" Checked="Pick_Checked">
                                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Rightmost value on the line"/><Run Text=" (recommended): whatever number sits furthest right, usually the line total. Most reliable on scans."/></TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="PickMoney" GroupName="Pick" Checked="Pick_Checked">
                                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Rightmost dollar amount"/><Run Text=": only numbers written as money (12.50, $1,825), skipping quantities and codes."/></TextBlock>
                                </RadioButton>
                            </StackPanel>
                            <RadioButton x:Name="ModeRow" GroupName="Mode" Checked="Mode_Checked"
                                         Content="Whole line, split into Excel columns (item, description, qty, unit, amount)"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,0"
                                       Text="With column focus on, only the focused columns are used."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="AutoGrabSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="AutoGrabSwitch_Changed" Unchecked="AutoGrabSwitch_Changed" AutomationProperties.Name="Auto grab"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Auto grab" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="Copy automatically every time the band moves. Press Ctrl+Alt+↓, switch to Excel, paste. If a line has no value, you're told and the clipboard is left alone."/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="AutoGrabScopePanel" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Copies:" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="AutoGrabTop" GroupName="AutoScope" Content="Top line" Margin="0,0,16,0" Checked="AutoScope_Checked"/>
                                <RadioButton x:Name="AutoGrabAll" GroupName="AutoScope" Content="Every line in the band" Checked="AutoScope_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ValueGrabButtonSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="ValueGrabButtonSwitch_Changed" Unchecked="ValueGrabButtonSwitch_Changed" AutomationProperties.Name="Show Value Grab button"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Show the Value Grab button in the toolbar" FontWeight="SemiBold"/>
                                <TextBlock Text="Turn off to keep Value Grab out of sight entirely; you can still switch it on here."
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Highlights -->
                <StackPanel x:Name="HighlightsPage" Visibility="Collapsed">
                    <TextBlock Text="Highlights" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="HighlightIntro" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                    <Grid>
                                        <Border x:Name="HighlightPreview" CornerRadius="2" Margin="-4,-1"/>
                                        <TextBlock Text="Toner cartridge   4   359.96" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Colour" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel x:Name="SwatchPanel" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Custom" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="CustomColorBox" Width="96" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                                         FontFamily="{StaticResource MonoFont}" KeyDown="CustomColorBox_KeyDown"
                                         AutomationProperties.Name="Custom highlight colour, as #RRGGBB"/>
                                <Button Content="Use" Style="{StaticResource SecondaryButton}" Height="30" Margin="8,0,0,0" Click="CustomColor_Click"/>
                                <TextBlock x:Name="CustomColorError" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock x:Name="HighlightStrengthValue" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                                <TextBlock Text="Strength" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="HighlightStrength" Minimum="0.15" Maximum="0.7" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="HighlightStrength_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="What to highlight" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <RadioButton x:Name="HighlightWholeLine" GroupName="HlWhat" Margin="0,0,0,6" Checked="HighlightWhat_Checked"
                                         Content="The whole line (just the focused columns when column focus is on)"/>
                            <RadioButton x:Name="HighlightValueOnly" GroupName="HlWhat" Checked="HighlightWhat_Checked"
                                         Content="Just the value: the same number Value Grab copies"/>
                            <TextBlock Text="Which lines" FontWeight="SemiBold" Margin="0,14,0,8"/>
                            <RadioButton x:Name="HighlightTopLine" GroupName="HlWhich" Margin="0,0,0,6" Checked="HighlightWhich_Checked" Content="The top line of the band"/>
                            <RadioButton x:Name="HighlightAllLines" GroupName="HlWhich" Checked="HighlightWhich_Checked" Content="Every line in the band"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="AutoHighlightSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="AutoHighlightSwitch_Changed" Unchecked="AutoHighlightSwitch_Changed" AutomationProperties.Name="Auto-highlight"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Highlight lines automatically" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Every line the band moves forward past gets highlighted, so you can see what's done without pressing anything. Moving back or clicking doesn't highlight."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="SaveToPdfSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="SaveToPdfSwitch_Changed" Unchecked="SaveToPdfSwitch_Changed" AutomationProperties.Name="Save highlights into the PDF"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Save highlights into the PDF file" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Off: highlights are kept by Line by Line only and the file is never changed. On: they're also written into the PDF as standard highlights, so Acrobat, Edge and other viewers show them. Images and scans can't hold highlights, so theirs stay in the app."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="2,4,0,0">
                        <Button x:Name="ClearHighlightsButton" DockPanel.Dock="Right" Content="Clear all highlights" Style="{StaticResource SecondaryButton}" Click="ClearHighlights_Click"/>
                        <TextBlock x:Name="HighlightCountText" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    </DockPanel>
                </StackPanel>

                <!-- Window -->
                <StackPanel x:Name="WindowPage" Visibility="Collapsed">
                    <TextBlock Text="Window" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="TopmostSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="TopmostSwitch_Changed" Unchecked="TopmostSwitch_Changed" AutomationProperties.Name="Always on top"/>
                            <StackPanel>
                                <TextBlock Text="Always on top" FontWeight="SemiBold"/>
                                <TextBlock Text="Keep Line by Line above other windows, handy on a single monitor." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="RememberSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="RememberSwitch_Changed" Unchecked="RememberSwitch_Changed" AutomationProperties.Name="Resume where you left off"/>
                            <StackPanel>
                                <TextBlock Text="Resume where you left off" FontWeight="SemiBold"/>
                                <TextBlock Text="Reopening a file puts the band back on the line you were on." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                    <TextBlock Text="Updates" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Click="CheckUpdates_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock x:Name="InstalledVersionText" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Shown when GitHub has a newer release -->
                    <Border x:Name="UpdateCard" Visibility="Collapsed" Background="#EEF4FF" BorderBrush="#B9D1FB" BorderThickness="1"
                            CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Height="20" Padding="8,0" Margin="0,0,10,0">
                                    <TextBlock Text="New" Foreground="#0E1B2E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UpdateTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="WHAT'S NEW" FontSize="11" Foreground="#4C6A9C" Margin="0,14,0,4"/>
                            <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" LineHeight="20"/>
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Hyperlink x:Name="ReleaseLink" Click="ReleaseLink_Click">View on GitHub</Hyperlink>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="UpdateNowButton" Content="Update &amp; restart now" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click"/>
                                    <Button x:Name="LaterButton" Content="Later" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Later_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="AutoUpdateSwitch_Changed" Unchecked="AutoUpdateSwitch_Changed"
                                      AutomationProperties.Name="Automatic updates"/>
                            <StackPanel>
                                <TextBlock Text="Automatic updates" FontWeight="SemiBold"/>
                                <TextBlock Text="Check every time Line by Line opens and install new versions automatically." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

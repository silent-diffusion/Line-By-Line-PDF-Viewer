<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme. Keys must match the other theme file; generated from one table so they can't drift. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B9BFF"/>  <!-- Focus band, primary buttons, selection -->
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1E4FA8"/>  <!-- Text and icons on AccentSoft; links -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9F1FF"/>  <!-- Selected/on state of toggles and the page rail -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1B2E"/>  <!-- Text on AccentBrush -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#F9F9FA"/>  <!-- Top bar and sidebar -->
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#E2E2E5"/>
    <SolidColorBrush x:Key="WorkspaceBrush" Color="#E6E6E9"/>  <!-- Behind the pages -->
    <SolidColorBrush x:Key="SegmentBrush" Color="#ECECEE"/>  <!-- Band lines/step segment -->
    <SolidColorBrush x:Key="SegmentPillBrush" Color="#FFFFFF"/>  <!-- The raised pill inside the segment -->
    <SolidColorBrush x:Key="TextBrush" Color="#1C1D20"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#4A4D55"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6A6E76"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#D9D9DD"/>
    <SolidColorBrush x:Key="HudBrush" Color="#1C1D20"/>  <!-- Bottom pill, toasts -->
    <SolidColorBrush x:Key="HudButtonBrush" Color="#2C2E33"/>
    <SolidColorBrush x:Key="HudTextBrush" Color="#E9EAED"/>
    <SolidColorBrush x:Key="HudMutedBrush" Color="#B4B7BE"/>
    <SolidColorBrush x:Key="HudSeparatorBrush" Color="#3A3B40"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="LogoLineBrush" Color="#A0A3AA"/>  <!-- Grey lines in the logo -->
    <SolidColorBrush x:Key="GripBrush" Color="#C9CCD2"/>  <!-- Band grip dots -->
    <SolidColorBrush x:Key="HandleFillBrush" Color="#FFFFFF"/>  <!-- Band resize handles -->
    <SolidColorBrush x:Key="TileBrush" Color="#FFFFFF"/>  <!-- Empty-state logo tile -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F6F7"/>  <!-- Settings window background -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>  <!-- Settings cards -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#EFEFF1"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E8E8EB"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF"/>  <!-- Secondary buttons -->
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D6D7DB"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F3F3F5"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>  <!-- Text boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#ABADB3"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#C9CBD1"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A9ABB2"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#FFFFFF"/>  <!-- Value Grab chips beside the band -->
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#D6D7DB"/>
    <SolidColorBrush x:Key="KbdBrush" Color="#F6F6F7"/>  <!-- Keyboard-shortcut hints -->
    <SolidColorBrush x:Key="KbdBorderBrush" Color="#C9CACE"/>
    <SolidColorBrush x:Key="UpdateCardBrush" Color="#EEF4FF"/>  <!-- "Update available" card -->
    <SolidColorBrush x:Key="UpdateCardBorderBrush" Color="#B9D1FB"/>
    <SolidColorBrush x:Key="UpdateCardLabelBrush" Color="#4C6A9C"/>
</ResourceDictionary>

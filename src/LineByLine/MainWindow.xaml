<Window x:Class="LineByLine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line by Line" Icon="app.ico" Width="1280" Height="800" MinWidth="520" MinHeight="480"
        Background="{StaticResource WorkspaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Canvas Width="18" Height="18" Margin="0,0,8,0">
                        <Path Data="M2.25,3.4 H15.75 M2.25,14.6 H15.75" Stroke="#A0A3AA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Rectangle Canvas.Left="1.7" Canvas.Top="6.75" Width="14.6" Height="4.5" RadiusX="1.3" RadiusY="1.3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"/>
                    </Canvas>
                    <TextBlock Text="Line by Line" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="FileButton" Click="OpenButton_Click" Margin="10,0,0,0" Height="30" Width="Auto"
                            Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Open a PDF or scanned image (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock x:Name="FileNameText" Text="Open document…" Foreground="{StaticResource MutedTextBrush}"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Path Data="M4,6 L8,10 L12,6" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6"
                                  Width="12" Height="12" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Band segment: lines in view + step -->
                    <Border Background="{StaticResource SegmentBrush}" CornerRadius="8" Height="32" Padding="4,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Band" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                            <Border Background="White" CornerRadius="6" Height="26" Padding="2,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepButton}" Click="LinesMinus_Click" ToolTip="Fewer lines"/>
                                    <TextBlock x:Name="LinesText" Text="2" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="10" TextAlignment="Center"/>
                                    <TextBlock Text=" lines" VerticalAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource StepButton}" Click="LinesPlus_Click" ToolTip="More lines"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="step" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,2,0"/>
                            <Button Content="−" Style="{StaticResource StepButton}" Click="StepMinus_Click" ToolTip="Smaller step"/>
                            <TextBlock x:Name="StepText" Text="2" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="10" TextAlignment="Center"/>
                            <Button Content="+" Style="{StaticResource StepButton}" Click="StepPlus_Click" ToolTip="Bigger step"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="ValueGrabToggle" Style="{StaticResource IconButton}" Width="Auto" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Click="ValueGrabToggle_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="$" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ValueGrabLabel" Text="Value Grab" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="PinToggle" Style="{StaticResource IconButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                                  Click="PinToggle_Click" ToolTip="Always on top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" VerticalAlignment="Center" Click="SettingsButton_Click"
                            ToolTip="Settings" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: rail (portrait) + thumbnails -->
            <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="Rail" Width="56" Visibility="Collapsed">
                        <ToggleButton x:Name="ThumbsToggle" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,12,0,0"
                                      Click="ThumbsToggle_Click" ToolTip="Show page thumbnails">
                            <Path Data="M3.5,2.5 H12.5 A1.5,1.5 0 0 1 14,4 V12 A1.5,1.5 0 0 1 12.5,13.5 H3.5 A1.5,1.5 0 0 1 2,12 V4 A1.5,1.5 0 0 1 3.5,2.5 Z M6,2.5 V13.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Width="16" Height="16"/>
                        </ToggleButton>
                        <Border Width="28" Height="1" Background="{StaticResource ChromeBorderBrush}" Margin="0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="RailPages"/>
                        </ScrollViewer>
                    </StackPanel>
                    <ScrollViewer x:Name="ThumbScroller" Width="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ThumbPanel" Margin="0,20,0,20"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Workspace -->
            <Grid x:Name="Workspace" Grid.Column="1" ClipToBounds="True" Background="{StaticResource WorkspaceBrush}"
                  SizeChanged="Workspace_SizeChanged">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="Scroller_ScrollChanged" Focusable="False">
                    <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Margin="24,24,24,96"/>
                </ScrollViewer>

                <!-- Spotlight: dim everything except the band -->
                <Canvas x:Name="Overlay">
                    <Path x:Name="DimPath" Fill="#0C0E12" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <!-- Column focus: dashed outline around every line the band will stop on -->
                    <Rectangle x:Name="Region" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                               RadiusX="6" RadiusY="6" Opacity="0.85" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="RegionLabel" Background="{StaticResource HudBrush}" CornerRadius="9" Height="20" Padding="9,0"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="RegionLabelText" Foreground="#9CC2FF" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Band" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"
                            Background="Transparent" Cursor="SizeAll" Visibility="Collapsed"
                            MouseLeftButtonDown="Band_MouseLeftButtonDown" MouseMove="Band_MouseMove"
                            MouseLeftButtonUp="Band_MouseLeftButtonUp" MouseWheel="Band_MouseWheel"
                            MouseEnter="Band_MouseEnter" MouseLeave="Band_MouseLeave"
                            ToolTip="Drag to move · drag the side edges to focus on columns · drag top/bottom to change how many lines · double-click to reset width">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                    </Border>
                    <Rectangle x:Name="HandleLeft" Width="8" Height="16" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Rectangle x:Name="HandleRight" Width="8" Height="16" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Rectangle x:Name="HandleTop" Width="16" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Rectangle x:Name="HandleBottom" Width="16" Height="8" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <UniformGrid x:Name="Grip" Columns="2" Rows="3" Width="12" Height="18" IsHitTestVisible="False" Visibility="Collapsed">
                        <Ellipse Width="4" Height="4" Fill="#C9CCD2"/><Ellipse Width="4" Height="4" Fill="#C9CCD2"/>
                        <Ellipse Width="4" Height="4" Fill="#C9CCD2"/><Ellipse Width="4" Height="4" Fill="#C9CCD2"/>
                        <Ellipse Width="4" Height="4" Fill="#C9CCD2"/><Ellipse Width="4" Height="4" Fill="#C9CCD2"/>
                    </UniformGrid>
                </Canvas>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="16" Background="White" HorizontalAlignment="Center">
                        <Canvas Width="36" Height="36">
                            <Path Data="M4,8 H32 M4,30 H32" Stroke="#A0A3AA" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="3" Canvas.Top="14" Width="30" Height="9" RadiusX="2.5" RadiusY="2.5"
                                       Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="Drop a document here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="The band highlights a line at a time. Move it from anywhere, even while Excel has focus."
                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="360"/>
                    <Button Content="Open document…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Click="OpenButton_Click"/>
                    <TextBlock x:Name="EmptyHints" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12"/>
                </StackPanel>

                <!-- HUD pill -->
                <Border x:Name="Hud" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18" Height="40"
                        CornerRadius="20" Background="{StaticResource HudBrush}" Padding="16,0,6,0" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HudLines" Foreground="{StaticResource HudTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Border x:Name="HudSeparator" Width="1" Height="16" Background="#3A3B40" Margin="12,0"/>
                        <StackPanel x:Name="HudChips" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"/>
                        <Button x:Name="ColumnChip" Click="ColumnChip_Click" Visibility="Collapsed" Margin="0,0,10,0" Cursor="Hand" Focusable="False"
                                ToolTip="Back to full-width lines (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#26406B" CornerRadius="12" Height="24" Padding="10,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Column focus" Foreground="#CFE0FF" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#CFE0FF"
                                                       VerticalAlignment="Center" Margin="7,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#335389"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="HudHints" Foreground="{StaticResource HudMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource HudButton}" Click="PrevButton_Click" ToolTip="Previous line(s)" Margin="0,0,6,0">
                            <Path Data="M4,10 L8,6 L12,10" Stroke="{StaticResource HudTextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource HudPrimaryButton}" Click="NextButton_Click" ToolTip="Next line(s)">
                            <Path Data="M4,6 L8,10 L12,6" Stroke="#0E1B2E" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,16,16,0" CornerRadius="8"
                        Background="{StaticResource HudBrush}" Padding="14,9" Visibility="Collapsed" MaxWidth="560">
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
